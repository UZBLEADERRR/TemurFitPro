{
  "name": "temurfitpro",
  "version": "1.0.0",
  "description": "TemurFitPro — multi-tenant SaaS ratsion nazorat platformasi (Telegram)",
  "main": "src/index.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx prisma db push --accept-data-loss --skip-generate && npx tsx src/index.ts",
    "dev": "npx tsx watch src/index.ts",
    "build": "npx tsc --noEmit && cd client && npm install && npm run build",
    "typecheck": "npx tsc --noEmit",
    "postinstall": "npx prisma generate",
    "migrate": "npx prisma migrate deploy"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "geo-tz": "^8.1.6",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
