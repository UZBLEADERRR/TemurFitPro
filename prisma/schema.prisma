// TemurFitPro — multi-tenant (SaaS) ratsion nazorat platformasi.
// Bitta Railway servisi N ta Telegram botni webhook orqali boshqaradi.
// Har bir bot = bitta Tenant. Barcha jadvallar tenantId bo'yicha izolyatsiyalangan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase'da "Session pooler" (5432-port) yoki to'g'ridan-to'g'ri ulanish
  // satrini ishlating — bot uzoq yashaydigan jarayon, transaction pooler (6543)
  // prepared statement'larni buzadi.
  url      = env("DATABASE_URL")
}

// ============ PLATFORMA DARAJASI ============

/// Super adminlar — ona bot orqali yangi bot qo'shadi, tenantlarni boshqaradi.
/// Env'dagi SUPER_ADMIN_IDS startda shu jadvalga seed qilinadi.
model SuperAdmin {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  name       String   @default("")
  addedByTgId String?
  createdAt  DateTime @default(now())
}

/// Bitta mijoz boti. botToken AES-256-GCM bilan shifrlangan holda saqlanadi.
model Tenant {
  id            String  @id @default(cuid())
  botId         String  @unique /// Telegram bot raqamli id (token'ning birinchi qismi)
  botUsername   String
  botTitle      String  @default("")
  botTokenEnc   String  /// AES-256-GCM shifrlangan bot token
  webhookSecret String  /// URL yo'lidagi va X-Telegram-Bot-Api-Secret-Token dagi sir
  status        String  @default("active") /// active | paused

  /// AI agent nomi — murabbiy shu nom bilan chaqiradi ("Feruza, ...")
  agentName     String  @default("Feruza")
  /// Murabbiyning yozish uslubi — AI xabarlarni shu uslubda yozadi
  coachStyle    String  @default("")
  /// Ixtiyoriy per-tenant Gemini kaliti (shifrlangan). Bo'sh bo'lsa global kalit ishlatiladi.
  geminiKeyEnc  String?

  timezone      String  @default("Asia/Tashkent")
  createdByTgId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Ratsion sozlamalari ---
  breakfastTime    String  @default("08:00")
  lunchTime        String  @default("13:00")
  dinnerTime       String  @default("19:00")
  graceMinutes     Int     @default(60) /// shu daqiqadan keyin "kech" hisoblanadi
  reminderInterval Int     @default(60) /// eslatmalar orasidagi daqiqa
  maxReminders     Int     @default(3)
  dailyTableHour   Int     @default(6)  /// kunlik jadval yuboriladigan soat (tenant timezone)
  requirePhoto     Boolean @default(true)
  autoDeleteReminders Boolean @default(true)

  breakfastWords String @default("nonushta,#nonushta,ertalabki")
  lunchWords     String @default("tushlik,#tushlik,abed,#abed,obed")
  dinnerWords    String @default("kechki,#kechki,kechki_ovqat,#kechki_ovqat,uzhin")

  groups        Group[]
  members       Member[]
  mealRecords   MealRecord[]
  mentions      Mention[]
  reminderOverrides ReminderOverride[]
  businessConnections BusinessConnection[]
  outbox        OutboundMessage[]
  aiMessages    AiMessage[]
  auditLogs     AuditLog[]
  sessions      BotSession[]

  @@index([status])
}

// ============ TENANT DARAJASI ============

/// Bir tenantda bir nechta guruh bo'lishi mumkin — barchasi bitta bot bilan ishlaydi.
model Group {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatId    String  /// Telegram chat id (manfiy son, string sifatida)
  title     String  @default("")
  isActive  Boolean @default(true)
  pinnedMessageId Int?
  lastTableDate   String? /// oxirgi kunlik jadval sanasi (yyyy-MM-dd)
  createdAt DateTime @default(now())

  members     GroupMember[]
  mealRecords MealRecord[]
  mentions    Mention[]

  @@unique([tenantId, chatId])
  @@index([tenantId, isActive])
}

/// Tenant ichidagi foydalanuvchi. role: owner | coach | member
model Member {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramId String
  name       String
  username   String?
  role       String  @default("member") /// owner | coach | member
  status     String  @default("active") /// active | paused | left
  timezone   String  @default("Asia/Tashkent")
  latitude   Float?
  longitude  Float?
  /// Bot bilan shaxsiy chat ochilganmi (DM yuborish uchun kerak)
  dmOpen     Boolean @default(false)
  note       String  @default("")
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groups            GroupMember[]
  mealRecords       MealRecord[]
  mentions          Mention[]
  reminderOverrides ReminderOverride[]
  outbox            OutboundMessage[]

  @@unique([tenantId, telegramId])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model GroupMember {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
}

model MealRecord {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  date      String   /// foydalanuvchi mahalliy sanasi yyyy-MM-dd
  mealType  String   /// nonushta | tushlik | kechki
  timeSent  DateTime
  status    String   /// on_time | late
  photoFileId String?
  messageId Int?
  caption   String?

  @@unique([memberId, date, mealType])
  @@index([tenantId, date])
  @@index([tenantId, memberId, date])
}

/// Guruhda yuborilgan eslatma xabari — keyin o'chirish/yangilash uchun kuzatiladi.
model Mention {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mealType  String
  date      String
  messageId Int
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([groupId, memberId, mealType, date])
  @@index([tenantId, date])
}

model ReminderOverride {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mealType String /// nonushta | tushlik | kechki | all
  muted    Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([memberId, mealType])
}

// ============ TELEGRAM BUSINESS ============

/// Murabbiy botni o'z Telegram Business akkauntiga ulaganda saqlanadi.
/// canReply=true bo'lsa bot xabarlarni AYNAN murabbiy nomidan yuboradi.
model BusinessConnection {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String  @unique /// Telegram business_connection.id
  userTgId     String  /// murabbiyning telegram id'si
  userChatId   String
  userName     String  @default("")
  canReply     Boolean @default(false)
  isEnabled    Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, isEnabled])
}

/// Rejalashtirilgan / navbatdagi chiquvchi xabarlar.
/// channel: business (murabbiy nomidan) | bot (bot nomidan) | group
model OutboundMessage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  chatId       String   /// yuboriladigan chat (odatda memberning telegramId'si)
  text         String
  channel      String   @default("business")
  connectionId String?
  scheduledFor DateTime @default(now())
  status       String   @default("pending") /// pending | sent | failed | cancelled
  attempts     Int      @default(0)
  error        String?
  sentAt       DateTime?
  createdByTgId String?
  batchId      String?  /// bitta buyruq bilan yuborilgan guruh
  createdAt    DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([tenantId, batchId])
}

// ============ AI ============

/// AI suhbat xotirasi. chatKey = "<tenantId>:<telegramId>"
model AiMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatKey   String
  role      String   /// user | model | tool
  content   String
  createdAt DateTime @default(now())

  @@index([chatKey, createdAt])
}

// ============ UMUMIY ============

/// Ko'p bosqichli inline-keyboard dialoglari uchun holat (restartga chidamli).
/// scope = "control" (ona bot) yoki tenantId.
model BotSession {
  id        String   @id @default(cuid())
  scope     String
  chatId    String
  state     String   @default("idle")
  payload   String   @default("{}")
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([scope, chatId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorTgId String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
