# ============ MAJBURIY ============

# Ona (control) botning tokeni — @BotFather dan olinadi.
# FAQAT shu token env'da turadi. Qolgan barcha mijoz botlari ona bot ichidan
# "➕ Yangi bot qo'shish" tugmasi orqali qo'shiladi va bazada shifrlangan holda saqlanadi.
CONTROL_BOT_TOKEN=123456789:AA...

# Sizning Telegram ID raqamingiz (vergul bilan bir nechta bo'lishi mumkin).
# Faqat shu odamlar ona botga kira oladi. ID ni bilish uchun ona botga /id yozing.
SUPER_ADMIN_IDS=123456789

# Bot tokenlarini shifrlash kaliti. Uzun tasodifiy satr bo'lsin.
# DIQQAT: bir marta o'rnatgach O'ZGARTIRMANG — aks holda saqlangan tokenlar ochilmay qoladi.
# Yaratish: openssl rand -base64 32
ENCRYPTION_KEY=

# Railway bergan public domen (oxirida / bo'lmasin). Webhooklar shu manzilga o'rnatiladi.
# Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik keladi — u holda bu qatorni tashlab ketsa ham bo'ladi.
PUBLIC_URL=https://temurfitpro-production.up.railway.app

# ============ MA'LUMOTLAR BAZASI ============
#
# Alohida baza xizmati KERAK EMAS — hamma narsa Railway Volume ichidagi
# SQLite fayllarda yotadi. Qo'shimcha oylik to'lov yo'q.
#
#   <DATA_DIR>/platform.db          — botlar ro'yxati va super adminlar
#   <DATA_DIR>/tenants/<botId>.db   — HAR BIR BOT uchun alohida fayl
#
# Railway'da: Service → Settings → Volumes → Add Volume, mount path masalan /data.
# RAILWAY_VOLUME_MOUNT_PATH avtomatik keladi, shuning uchun DATA_DIR ni odatda
# qo'lda yozish shart emas. Lokalda standart qiymat — ./data
#
# DIQQAT: Volume ulanmasa, ma'lumotlar har deploy'da yo'qoladi.
# DATA_DIR=/data

# ============ AI YORDAMCHI ============

# Google AI Studio: https://aistudio.google.com/apikey (bepul limit bor)
#
# Kalit qo'ysangiz — murabbiy botga oddiy tilda yozadi yoki ovozli xabar
# yuboradi: "oxirgi 2 kunda yubormaganlarni top", "Dilnozaning nonushta
# eslatmasini o'chir", "ularga ertaga 9 da ogohlantirish yubor".
#
# Kalit bo'lmasa bot AI'siz TO'LIQ ishlayveradi — hamma narsa tugmalarda bor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# AI'ni butunlay o'chirish uchun false qiling
AI_ENABLED=true

# ============ IXTIYORIY ============

# Ona bot webhookining sirli qismi. O'zgartirsangiz xavfsizroq bo'ladi.
CONTROL_WEBHOOK_SECRET=control

PORT=3000
NODE_ENV=production
