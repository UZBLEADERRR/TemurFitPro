# ============ MAJBURIY ============

# Ona (control) botning tokeni — @BotFather dan olinadi.
# FAQAT shu token env'da turadi. Qolgan barcha mijoz botlari ona bot ichidan
# "➕ Yangi bot qo'shish" tugmasi orqali qo'shiladi va bazada shifrlangan holda saqlanadi.
CONTROL_BOT_TOKEN=123456789:AA...

# Sizning Telegram ID raqamingiz (vergul bilan bir nechta bo'lishi mumkin).
# Faqat shu odamlar ona botga kira oladi. ID ni bilish uchun ona botga /id yozing.
SUPER_ADMIN_IDS=123456789

# Bot tokenlarini shifrlash kaliti. Uzun tasodifiy satr bo'lsin.
# DIQQAT: bir marta o'rnatgach O'ZGARTIRMANG — aks holda saqlangan tokenlar ochilmay qoladi.
# Yaratish: openssl rand -base64 32
ENCRYPTION_KEY=

# Supabase Postgres ulanish satri.
# Supabase → Project Settings → Database → Connection string → "Session pooler" (5432-port).
# Transaction pooler (6543) ISHLATMANG — Prisma prepared statement'lari buziladi.
DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-region.pooler.supabase.com:5432/postgres

# Railway bergan public domen (oxirida / bo'lmasin). Webhooklar shu manzilga o'rnatiladi.
# Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik keladi — u holda bu qatorni tashlab ketsa ham bo'ladi.
PUBLIC_URL=https://temurfitpro-production.up.railway.app

# ============ AI (ixtiyoriy, lekin tavsiya etiladi) ============

# Google AI Studio: https://aistudio.google.com/apikey
# Bo'lmasa bot ishlayveradi, lekin AI yordamchi va ovozli buyruqlar o'chiq bo'ladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# minimal | low | medium | high — bo'sh qoldirsangiz model o'zi tanlaydi
GEMINI_THINKING_LEVEL=

# ============ IXTIYORIY ============

# Ona bot webhookining sirli qismi. O'zgartirsangiz xavfsizroq bo'ladi.
CONTROL_WEBHOOK_SECRET=control

PORT=3000
NODE_ENV=production
